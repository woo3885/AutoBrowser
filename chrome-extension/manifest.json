{
  "manifest_version": 3,
  "name": "AutoBrowser",
  "version": "0.2.1",
  "description": "현재 Chrome 탭을 이해하고 안전한 동작을 수행하는 AI 브라우저 도우미",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AutoBrowser 열기/닫기"
  }
}
